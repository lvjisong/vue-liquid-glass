# ============================================================
# .env.production —— 生产环境变量（npm run build 自动加载）
# ------------------------------------------------------------
# 生产用的 API / 站点 / 图片域名都在这里配，构建后注入 bundle。
# 上线前必改：三个 <-- 按项目替换 --> 换成真实生产地址。
# ============================================================
VUE_APP_ENV=production
VUE_APP_BASE_API=<-- 按项目替换：https://api.your-domain.com -->
VUE_APP_IMAGE_BASE=<-- 按项目替换：图片 CDN 或静态路径 -->
VUE_APP_SITE_URL=<-- 按项目替换：https://your-domain.com -->
