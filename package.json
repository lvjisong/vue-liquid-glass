{
  "name": "vue3-element-plus-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:report": "cross-env ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.vue",
    "format": "prettier --write \"src/**/*.{vue,js,scss,css}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "core-js": "^3.8.3",
    "element-plus": "^2.14.7",
    "html2canvas": "^1.4.1",
    "spark-md5": "^3.0.2",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "compression-webpack-plugin": "^12.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^7.0.4",
    "lint-staged": "^17.6.0",
    "prettier": "^2.8.8",
    "sass": "^1.105.1",
    "sass-loader": "^10.5.2",
    "terser": "^5.36.0",
    "vite": "^7.0.0",
    "vite-plugin-compression2": "^2.5.4",
    "webpack-bundle-analyzer": "^5.4.0"
  },
  "lint-staged": {
    "src/**/*.{vue,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{scss,css}": [
      "prettier --write"
    ]
  }
}
