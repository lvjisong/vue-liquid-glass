# ============================================================
# .env.staging —— 预发布环境变量（npm run build:staging 自动加载）
# ------------------------------------------------------------
# 用途：上线前在 staging 服务器验证，地址单独配置，与生产隔离。
# 接后端：VUE_APP_BASE_API 换成 staging 后端真实地址。
# ============================================================
VUE_APP_ENV=staging
VUE_APP_BASE_API=https://staging-api.example.com   # <-- 按项目替换
VUE_APP_IMAGE_BASE=/images
VUE_APP_SITE_URL=<-- 按项目替换：staging 站点域名 -->
